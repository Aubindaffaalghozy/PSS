# Environment Variables Configuration
# Rename this file to .env and update values for your setup

# WordPress Configuration
WORDPRESS_DB_HOST=mysql
WORDPRESS_DB_NAME=wordpress_db
WORDPRESS_DB_USER=wordpress_user
WORDPRESS_DB_PASSWORD=wordpress_password

# MySQL Configuration
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wordpress_user
MYSQL_PASSWORD=wordpress_password

# WordPress Port (change if 8000 is already in use)
WORDPRESS_PORT=8000

# Redis Configuration
REDIS_PORT=6379

# Container Names
WORDPRESS_CONTAINER=wordpress_app
MYSQL_CONTAINER=mysql_db
REDIS_CONTAINER=redis_cache

# Network Name
NETWORK_NAME=wordpress_network

# Volume Names
WORDPRESS_VOLUME=wordpress_data
MYSQL_VOLUME=mysql_data
REDIS_VOLUME=redis_data
